<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.wilfison.Vinheta</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Vinheta</name>
  <summary>Play sounds into your calls</summary>
  <description>
    <p>Vinheta is a soundboard. Add your folders of sounds, and each one becomes a tab with a pad per sound: click a pad, or press its key, to play it. Pads can have a name, a color, a volume, and a loop, and your favorites are kept in a tab of their own.</p>
    <p>While it runs, Vinheta plays your sounds into the apps that are using your microphone. Join a call as usual, and the other side hears the sounds together with your voice. You hear them on your own headphones, with a separate volume.</p>
    <p>For a call, turn off the noise suppression of the call app (it treats sounds as noise) and use headphones. Sending sounds to the call can be switched off at any time, leaving only your own output.</p>
  </description>

  <developer id="io.github.wilfison">
    <name translate="no">wilfison</name>
  </developer>

  <url type="homepage">https://github.com/wilfison/Vinheta</url>
  <url type="vcs-browser">https://github.com/wilfison/Vinheta</url>
  <url type="bugtracker">https://github.com/wilfison/Vinheta/issues</url>

  <translation type="gettext">vinheta</translation>
  <launchable type="desktop-id">io.github.wilfison.Vinheta.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#f8e45c</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/wilfison/Vinheta/main/data/screenshots/main.png</image>
      <caption>Pads with colors, keys, and a sound playing</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/wilfison/Vinheta/main/data/screenshots/preferences.png</image>
      <caption>Audio and playback preferences</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/wilfison/Vinheta/main/data/screenshots/call-guide.png</image>
      <caption>The call setup guide</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.1.0" date="2026-10-05">
      <description>
        <p>The sounds play straight into the apps that use your microphone, with no virtual microphone to choose, and the app has a new icon.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-10-04">
      <description>
        <p>The first release: folders as tabs, pads with a name, a color, a volume, a loop and a key, favorites, search, and a virtual microphone that sends the sounds to your calls.</p>
      </description>
    </release>
  </releases>

</component>
