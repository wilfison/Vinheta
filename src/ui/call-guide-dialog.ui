<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="VinhetaCallGuideDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Use Vinheta in a Call</property>
    <property name="content-width">480</property>
    <property name="default-widget">got_it</property>
    <property name="focus-widget">got_it</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="propagate-natural-height">True</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">480</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">18</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Vinheta plays your sounds into the apps that are using your microphone. For the other side of a call to hear them:</property>
                        <property name="wrap">True</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBox">
                        <property name="selection-mode">none</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                        <child>
                          <object class="AdwActionRow">
                            <property name="activatable">False</property>
                            <property name="title" translatable="yes">Join the call as usual</property>
                            <property name="subtitle" translatable="yes">Keep your own microphone in the call app. Vinheta adds the sounds to what the app records, while both are running.</property>
                            <child type="prefix">
                              <object class="GtkLabel">
                                <property name="label">1</property>
                                <property name="valign">center</property>
                                <accessibility>
                                  <property name="label" translatable="yes">Step 1</property>
                                </accessibility>
                                <style>
                                  <class name="step-number"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="activatable">False</property>
                            <property name="title" translatable="yes">Choose where the sounds go</property>
                            <property name="subtitle" translatable="yes">Every app that is using the microphone gets them. To leave the others out, pick one app in the bottom bar.</property>
                            <child type="prefix">
                              <object class="GtkLabel">
                                <property name="label">2</property>
                                <property name="valign">center</property>
                                <accessibility>
                                  <property name="label" translatable="yes">Step 2</property>
                                </accessibility>
                                <style>
                                  <class name="step-number"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">If the sounds come through choppy, look in the call app for how to turn off its noise suppression.</property>
                        <property name="wrap">True</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dimmed"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="got_it">
                        <property name="label" translatable="yes">Got It</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
